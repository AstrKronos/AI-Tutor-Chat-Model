# Active AI Provider ('gemini', 'nvidia', or 'opencode')
AI_PROVIDER=nvidia

# OpenCode Zen API Configuration (Active when AI_PROVIDER=opencode)
OPENCODE_API_KEY=
OPENCODE_MODEL=nemotron-3.5-lightning-free

# NVIDIA API Configuration (Active when AI_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Google Gemini API Configuration (Active when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Configuration
PORT=8000
HOST=0.0.0.0
